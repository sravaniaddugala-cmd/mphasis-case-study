KAFKA_TOPIC_PAYMENT_INBOUND=payments.inbound
KAFKA_TOPIC_PAYMENT_RETRY=payments.retry
KAFKA_TOPIC_PAYMENT_DLT=payments.dead-letter
KAFKA_TOPIC_AUDIT=payments.audit
KAFKA_MAX_RETRIES=3
KAFKA_REPLAY_INTERVAL_MS=3600000
